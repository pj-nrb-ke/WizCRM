DATABASE_URL=postgresql://wizcrm:wizcrm_dev@127.0.0.1:5434/wizcrm
PORT=3000
JWT_SECRET=dev-jwt-secret-change-in-production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Desk tab: rules-only (fast). Set to 1 for LLM-ranked desk (slower, ~10–30s per load).
WIZCRM_DESK_USE_AI=0
RUN_INTEGRATION_TESTS=0

# Email (Brevo) — prefer docs/brevo.local.txt or config/secrets/brevo.local.txt
APP_URL=https://app.wizcrm.app
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_FROM_NAME=WizCRM
# BREVO_API_KEY=

# Lead Generator
# GOOGLE_PLACES_API_KEY=   — Google Places API key for AI prospect discovery (free monthly credit)
# BREVO_CAMPAIGN_API_KEY=  — Brevo Campaign API key (can be same as BREVO_API_KEY)

# Contact Finder — waterfall providers (register free at each site)
# APOLLO_API_KEY=          — apollo.io → Settings → API (master key)
# HUNTER_API_KEY=          — hunter.io → Dashboard → API Key
# PROSPEO_API_KEY=         — prospeo.io → Settings → API Key
# TOMBA_API_KEY=           — tomba.io → Settings → API Key (the starred/primary key)
# TOMBA_API_SECRET=        — tomba.io → Settings → API Secret (the key icon / second value)

# Brevo Webhooks (Phase 7 — Engagement Tracking)
# BREVO_WEBHOOK_SECRET=     — shared secret; set the same value in Brevo dashboard → Transactional → Webhooks → "Custom Header"
#                              Header name: X-WizCRM-Webhook-Key

# Africa's Talking (AI BDR). Put the REAL values in api/.env, never here.
# AT_USERNAME=             — Africa's Talking username (use 'sandbox' for testing)
# AT_API_KEY=              — Africa's Talking API key (dashboard → Settings → API Key)
# --- Voice (ACTIVE) ---
# AT_VOICE_NUMBER=         — AT virtual/caller-ID number used as callFrom (test numbers are temporary!)
# API_PUBLIC_URL=          — public base URL of THIS api (default https://api.wizcrm.app); builds the AT voice callback
# AT_VOICE_CALLBACK_SECRET= — optional; if set, the voice callback requires ?k=<secret> (add it to the dashboard URL too)
# In the AT dashboard, set the voice number's Callback URL to: <API_PUBLIC_URL>/webhooks/africastalking/voice
# --- WhatsApp (PENDING activation) ---
# AT_WA_NUMBER=            — WhatsApp Business number (waNumber), once the WABA is approved
# AT_WA_WEBHOOK_SECRET=    — shared secret for the inbound WhatsApp webhook (constant-time compared)
