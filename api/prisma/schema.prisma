generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String           @id @default(uuid())
  name            String
  settings        Json             @default("{}")
  createdAt       DateTime         @default(now())
  users           User[]
  leads           Lead[]
  teams           Team[]
  campaigns       Campaign[]
  emailTemplates  EmailTemplate[]
  suppressionList SuppressionList[]
  contactCaches   ContactFinderCache[]
  productDocuments ProductDocument[]
  expos           Expo[]
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(SALES)
  failedLoginCount Int        @default(0)
  lockoutUntil   DateTime?
  createdAt      DateTime     @default(now())
  ownedLeads          Lead[]            @relation("LeadOwner")
  activities          Activity[]
  tasks               Task[]
  calendarEvents      CalendarEvent[]
  eventInvites        CalendarEventAttendee[] @relation("EventAttendee")
  userReminders       UserReminder[]
  salesOpportunities  SalesOpportunity[] @relation("OpportunityOwner")
  quotations          Quotation[]
  aiAuditLogs         AiAuditLog[]
  stageChanges        StageChange[]
  leadMessages        LeadMessage[]
  leadAttachments     LeadAttachment[]
  ownedCampaigns      Campaign[]        @relation("CampaignOwner")
  emailTemplates      EmailTemplate[]   @relation("EmailTemplateCreator")
  suppressionEntries  SuppressionList[] @relation("SuppressionAddedBy")
  productDocuments    ProductDocument[]

  @@index([organizationId])
  @@index([teamId])
}

enum UserRole {
  SALES
  MANAGER
  ADMIN
}

model Lead {
  id               String     @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  ownerId          String
  owner            User       @relation("LeadOwner", fields: [ownerId], references: [id])
  name             String
  company          String?
  email            String?
  emailNormalized  String?
  phone            String?
  phoneNormalized  String?
  extraPhones      Json     @default("[]")
  extraEmails      Json     @default("[]")
  address          String?
  googleMapsUrl    String?
  source           String?
  tags             String[]   @default([])
  priority         LeadPriority?
  stage            LeadStage  @default(NEW)
  wonValue         Decimal?   @db.Decimal(14, 2)
  wonStartAt       DateTime?
  wonProducts      String?
  lossReason       String?
  /** Sort order within a pipeline column (lower = higher on the board). */
  pipelineRank     Int        @default(0)
  lastActivityAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  activities       Activity[]
  tasks            Task[]
  stageChanges     StageChange[]
  salesOpportunities SalesOpportunity[]
  quotations         Quotation[]
  calendarEvents     CalendarEvent[]
  aiSuggestions      AiSuggestion[]
  messages           LeadMessage[]
  attachments        LeadAttachment[]
  userReminders      UserReminder[]
  importedProspects  Prospect[]

  @@index([organizationId, stage])
  @@index([organizationId, stage, pipelineRank])
  @@index([organizationId, ownerId])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model StageChange {
  id           String    @id @default(uuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage    LeadStage
  toStage      LeadStage
  note         String?
  suggestedByAi Boolean  @default(false)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([leadId, createdAt(sort: Desc)])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  STAGE_CHANGE
  SALES_OPPORTUNITY
  CALENDAR_EVENT
}

enum SalesOppStage {
  NEW_OPPORTUNITY
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED
}

enum SalesOppStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING
  WON
  LOST
  CANCELLED
}

enum OpportunitySourceType {
  OTHER
  REFERRAL
  CAMPAIGN
  EXISTING_CUSTOMER
  WEBSITE
  AGENT
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model Activity {
  id        String       @id @default(uuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  subject   String?
  body      String
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt(sort: Desc)])
}

/// Internal team thread per lead (FR-NTH-011) — not customer SMS.
model LeadMessage {
  id               String   @id @default(uuid())
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  body             String
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  attachments      LeadAttachment[]

  @@index([leadId, createdAt(sort: Desc)])
}

model LeadAttachment {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageId   String?
  message     LeadMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt(sort: Desc)])
}

/// Org-wide catalog/brochure library (R7) — shared product documents, not per-lead.
model ProductDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  category       String?          // "Catalog" | "Brochure" | "Price list" | "Spec sheet"
  productTags    String[]     @default([])
  fileName       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  version        Int          @default(1)
  isActive       Boolean      @default(true)
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
  @@index([organizationId, category])
}

model SalesOpportunity {
  id               String              @id @default(uuid())
  organizationId   String
  leadId           String
  lead             Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User                @relation("OpportunityOwner", fields: [ownerId], references: [id])
  referenceNumber  String
  description      String
  contactPerson    String?
  isPublic         Boolean             @default(true)
  oppStage         SalesOppStage       @default(NEW_OPPORTUNITY)
  oppStatus        SalesOppStatus        @default(NOT_STARTED)
  probabilityPct   Float               @default(10)
  sourceType       OpportunitySourceType @default(OTHER)
  sourceDetail     String?
  startDate        DateTime            @default(now())
  closeBy          DateTime?
  actualClose      DateTime?
  budgeted         Float?
  forecastedExcl   Float?
  isClosed         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, leadId])
  @@index([organizationId, ownerId])
}

enum AttendanceStatus {
  ON_TIME
  LATE
  NO_SHOW
  PARTIAL
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ErpSyncStatus {
  NONE
  PENDING
  SYNCED
  FAILED
}

model Quotation {
  id               String          @id @default(uuid())
  organizationId   String
  leadId           String
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User            @relation(fields: [ownerId], references: [id])
  referenceNumber  String
  status           QuotationStatus @default(DRAFT)
  taxRatePct       Float           @default(0)
  subtotal         Decimal         @db.Decimal(14, 2)
  taxAmount        Decimal         @db.Decimal(14, 2)
  total            Decimal         @db.Decimal(14, 2)
  lines            Json
  notes            String?
  validUntil       DateTime?
  /** When to follow up on a SENT quote (PRO-011). */
  followUpAt       DateTime?
  erpSyncStatus    ErpSyncStatus   @default(NONE)
  erpReference     String?
  erpSyncedAt      DateTime?
  erpLastError     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  erpSyncLogs      ErpSyncLog[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, leadId])
}

model ErpSyncLog {
  id             String        @id @default(uuid())
  organizationId String
  quotationId    String?
  quotation      Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  action         String
  status         ErpSyncStatus
  message        String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([quotationId])
}

enum CalendarEventType {
  MEETING
  DEMO
  EXPO
  PRESENTATION
  CONFERENCE_CALL
  CALL
  OTHER
}

enum MeetingMode {
  IN_PERSON
  ZOOM
  TEAMS
  GOOGLE_MEET
  PHONE
  WHATSAPP
  OTHER
}

enum RsvpStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

/** Reach of an expo, from a Nairobi vantage point. */
enum ExpoTier {
  LOCAL_KENYA
  EAST_AFRICA
  MIDDLE_EAST_AFRICA
  ASIA
  INTERNATIONAL
}

/** Take a stand, attend as a delegate, or leave it alone. */
enum ExpoRecommendation {
  BOOTH
  PARTICIPANT
  SKIP
}

/**
 * An upcoming trade show or exhibition, discovered from the public web.
 *
 * Every field that states a fact about the outside world (dates, venue) comes
 * from a cited `sourceUrl` — never from the model's own recollection — so a
 * blank date means "the source did not say", not "there is no date".
 */
model Expo {
  id                   String              @id @default(uuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  /** Stable identity across re-runs: slug of the name + the month it starts. */
  dedupKey             String
  tier                 ExpoTier
  /** What the event is, in a sentence or two. */
  brief                String?
  /** How WizAG should position itself there. */
  positioning          String?
  recommendation       ExpoRecommendation?
  recommendationReason String?
  startDate            DateTime?
  endDate              DateTime?
  /** Verbatim date text when the source gave no parseable date. */
  dateText             String?
  city                 String?
  country              String?
  venue                String?
  websiteUrl           String?
  /** The page this was read from. Always present; the row is dropped without it. */
  sourceUrl            String
  sourceTitle          String?
  /** 0-100. How firmly the source pins down the event, not the model's mood. */
  confidence           Int                 @default(0)
  industryTags         String[]            @default([])
  /** Set once someone puts this on the shared calendar. */
  calendarEventId      String?
  dismissedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([organizationId, dedupKey])
  @@index([organizationId, tier, startDate])
}

/** A colleague invited to a shared calendar event. The organiser is CalendarEvent.userId. */
model CalendarEventAttendee {
  id          String        @id @default(uuid())
  eventId     String
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("EventAttendee", fields: [userId], references: [id], onDelete: Cascade)
  status      RsvpStatus    @default(INVITED)
  respondedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model CalendarEvent {
  id                    String             @id @default(uuid())
  organizationId        String
  userId                String
  user                  User               @relation(fields: [userId], references: [id])
  leadId                String?
  lead                  Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title                 String
  notes                 String?
  startAt               DateTime
  endAt                 DateTime
  allDay                Boolean            @default(false)
  eventType             CalendarEventType  @default(MEETING)
  meetingMode           MeetingMode        @default(IN_PERSON)
  meetingUrl            String?
  recurrence            CalendarRecurrence @default(NONE)
  recurrenceIntervalDays Int?
  recurrenceUntil       DateTime?
  reminderMinutes       Int?
  /** Project / campaign tags (shared with leads via org tag list). */
  tags                  String[]           @default([])
  meetingAddress        String?
  meetingLat            Float?
  meetingLng            Float?
  checkInAt             DateTime?
  checkInLat            Float?
  checkInLng            Float?
  geofenceOverride      Boolean            @default(false)
  checkOutAt            DateTime?
  attendanceStatus      AttendanceStatus?
  attendees             CalendarEventAttendee[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([organizationId, userId, startAt])
  @@index([organizationId, leadId])
  @@index([organizationId, startAt])
}

model UserReminder {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  remindAt        DateTime
  tags            String[]  @default([])
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  calendarEventId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, userId, remindAt])
}

model Task {
  id          String    @id @default(uuid())
  organizationId String
  tags        String[]  @default([])
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, dueAt])
  @@index([organizationId])
}

model AiSuggestion {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String
  payload   Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model AiAuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  feature        String
  model          String?
  promptVersion  String   @default("v1")
  inputSummary   String?
  outputSummary  String?
  approved       Boolean?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
}

// ─── Lead Generator ────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ProspectStatus {
  NEW
  QUALIFIED
  ENRICHED
  EMAILED
  REPLIED
  IMPORTED
  REJECTED
  SUPPRESSED
}

enum EmailSendStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  UNSUBSCRIBED
}

model Campaign {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  ownerId          String
  owner            User           @relation("CampaignOwner", fields: [ownerId], references: [id])
  name             String
  goal             String?
  industryKeywords Json           @default("[]")
  locations        Json           @default("[]")
  sizeMin          Int?
  sizeMax          Int?
  scoringRules     Json           @default("{}")
  status           CampaignStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  prospects        Prospect[]
  emailTemplates   EmailTemplate[]
  sequences        EmailSequence[]
  runs             DiscoveryRun[]
  intentSignals    IntentSignal[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model DiscoveryRun {
  id           String             @id @default(uuid())
  campaignId   String
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       DiscoveryRunStatus @default(RUNNING)
  params       Json               @default("{}")
  resultsCount Int                @default(0)
  error        String?
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  prospects    Prospect[]

  @@index([campaignId])
}

model Prospect {
  id             String              @id @default(uuid())
  organizationId String
  campaignId     String
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  discoveryRunId String?
  discoveryRun   DiscoveryRun?       @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  companyName    String
  normalizedName String
  industry       String?
  sectorTags     Json                @default("[]")
  address        String?
  lat            Float?
  lng            Float?
  phone          String?
  website        String?
  source         String              @default("manual")
  sourceRef      String?
  score          Int                 @default(0)
  scoreBreakdown Json                @default("[]")
  tier           String?
  status         ProspectStatus      @default(NEW)
  dedupHash      String
  importedLeadId String?
  importedLead   Lead?               @relation(fields: [importedLeadId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  contacts       ProspectContact[]
  enrichment     ProspectEnrichment?
  emailSends     EmailSend[]

  @@unique([campaignId, dedupHash])
  @@index([campaignId])
  @@index([organizationId, status])
  @@index([campaignId, tier])
}

model ProspectContact {
  id          String   @id @default(uuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  fullName    String?
  role        String?
  email       String?
  emailStatus String   @default("unverified")
  phone       String?
  source      String?
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([prospectId])
}

model ProspectEnrichment {
  id                  String   @id @default(uuid())
  prospectId          String   @unique
  prospect            Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  websiteSummary      String?
  techStackDetected   Json     @default("[]")
  employeeEstimate    Int?
  existingErpDetected Boolean  @default(false)
  signals             Json     @default("{}")
  raw                 Json     @default("{}")
  enrichedAt          DateTime @default(now())
}

model EmailTemplate {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  campaignId     String?
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User            @relation("EmailTemplateCreator", fields: [createdById], references: [id])
  name           String
  subject        String
  bodyHtml       String
  mergeFields    Json            @default("[]")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sequences      EmailSequence[]

  @@index([organizationId])
}

model EmailSequence {
  id         String        @id @default(uuid())
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id])
  stepNumber Int
  delayDays  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model EmailSend {
  id             String          @id @default(uuid())
  prospectId     String
  prospect       Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequenceStep   Int
  brevoMessageId String?
  status         EmailSendStatus @default(PENDING)
  scheduledAt    DateTime?
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  repliedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([prospectId])
  @@index([brevoMessageId])
}

model SuppressionList {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyName    String?
  domain         String?
  email          String?
  addedById      String
  addedBy        User     @relation("SuppressionAddedBy", fields: [addedById], references: [id])
  reason         String?
  addedAt        DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, domain])
  @@index([organizationId, email])
}

model IntentSignal {
  id             String    @id @default(uuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source         String
  platform       String
  title          String
  snippet        String?
  url            String
  authorName     String?
  authorCompany  String?
  location       String?
  lat            Float?
  lng            Float?
  publishedAt    DateTime?
  intentStrength String
  engagementScore Int      @default(0)
  status         String    @default("NEW")
  dedupHash      String?
  raw            Json?
  createdAt      DateTime  @default(now())

  @@index([campaignId])
  @@index([campaignId, intentStrength])
  @@unique([campaignId, dedupHash])
}

// ─── Contact Finder Cache ───────────────────────────────────────────────────

model ContactFinderCache {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName    String
  normalizedName String
  domain         String?
  providers      String[]               @default([])
  contacts       ContactFinderContact[]
  lastQueriedAt  DateTime               @default(now())
  createdAt      DateTime               @default(now())

  @@unique([organizationId, normalizedName])
  @@index([organizationId, normalizedName])
}

model ContactFinderContact {
  id          String             @id @default(uuid())
  cacheId     String
  cache       ContactFinderCache @relation(fields: [cacheId], references: [id], onDelete: Cascade)
  name        String?
  title       String?
  email       String?
  phone       String?
  linkedinUrl String?
  fieldClass  String             @default("RoleBasedContact")
  lawfulBasis String?
  source      String
  retrievedAt DateTime
  createdAt   DateTime           @default(now())

  @@index([cacheId])
}
