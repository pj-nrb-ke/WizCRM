# Copy to api/.env (and set OPENAI_API_KEY for LLM features)

# Database (matches docker/docker-compose.yml)
DATABASE_URL=postgresql://wizcrm:wizcrm_dev@127.0.0.1:5434/wizcrm

# API
PORT=3000
# REQUIRED in production (NODE_ENV=production) — the server refuses to start
# without it. Use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-in-production

# Allowed browser origins (comma-separated). Defaults to app.wizcrm.app + local
# dev. The native mobile app sends no Origin and is unaffected.
# CORS_ORIGINS=https://app.wizcrm.app,http://localhost:5180

# LLM (required for AI features — INF-005)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Integration tests (optional)
RUN_INTEGRATION_TESTS=0

# Mobile — Android emulator → host machine API
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
