# Copy to api/.env (and set OPENAI_API_KEY for LLM features)

# Database (matches docker/docker-compose.yml)
DATABASE_URL=postgresql://wizcrm:wizcrm_dev@localhost:5433/wizcrm

# API
PORT=3000
JWT_SECRET=change-me-in-production

# LLM (required for AI features — INF-005)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Integration tests (optional)
RUN_INTEGRATION_TESTS=0

# Mobile — Android emulator → host machine API
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
